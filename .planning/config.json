{
  "runtime": "cursor",
  "model_profile": "inherit",
  "model_profile_overrides": {
    "cursor": {
      "opus": "cursor-grok-4.5-high",
      "sonnet": "composer-2.5",
      "haiku": "composer-2.5"
    }
  },
  "model_policy": {
    "provider": "custom",
    "budget": null,
    "high": "cursor-grok-4.5-high",
    "medium": "cursor-grok-4.5-medium",
    "low": "composer-2.5"
  },
  "effort": {
    "default": "high",
    "routing_tier_defaults": {
      "light": "low",
      "standard": "medium",
      "heavy": "high"
    },
    "agent_overrides": {
      "gsd-planner": "high",
      "gsd-roadmapper": "high",
      "gsd-debugger": "high",
      "gsd-debug-session-manager": "high",
      "gsd-assumptions-analyzer": "high",
      "gsd-eval-planner": "high",
      "gsd-framework-selector": "high",
      "gsd-security-auditor": "high",
      "gsd-user-profiler": "high",
      "gsd-verifier": "medium",
      "gsd-code-reviewer": "medium",
      "gsd-eval-auditor": "medium"
    }
  },
  "fast_mode": {
    "enabled": false,
    "routing_tier_defaults": {
      "light": false,
      "standard": false,
      "heavy": false
    },
    "agent_overrides": {
      "gsd-planner": false,
      "gsd-roadmapper": false,
      "gsd-debugger": false,
      "gsd-debug-session-manager": false,
      "gsd-assumptions-analyzer": false,
      "gsd-eval-planner": false,
      "gsd-framework-selector": false,
      "gsd-security-auditor": false,
      "gsd-user-profiler": false,
      "gsd-verifier": false,
      "gsd-code-reviewer": false,
      "gsd-eval-auditor": false,
      "gsd-executor": true,
      "gsd-code-fixer": false,
      "gsd-doc-writer": false,
      "gsd-phase-researcher": false,
      "gsd-project-researcher": false,
      "gsd-ui-researcher": false,
      "gsd-advisor-researcher": false,
      "gsd-ai-researcher": false,
      "gsd-domain-researcher": false,
      "gsd-doc-synthesizer": false,
      "gsd-research-synthesizer": false,
      "gsd-codebase-mapper": false,
      "gsd-pattern-mapper": false,
      "gsd-plan-checker": false,
      "gsd-integration-checker": false,
      "gsd-nyquist-auditor": false,
      "gsd-ui-checker": false,
      "gsd-ui-auditor": false,
      "gsd-doc-verifier": false,
      "gsd-doc-classifier": false,
      "gsd-intel-updater": false,
      "gsd-mempalace-curator": false
    }
  },
  "model_overrides": {
    "gsd-planner": "cursor-grok-4.5-high",
    "gsd-roadmapper": "cursor-grok-4.5-high",
    "gsd-executor": "composer-2.5-fast",
    "gsd-debugger": "cursor-grok-4.5-high",
    "gsd-debug-session-manager": "cursor-grok-4.5-high",
    "gsd-assumptions-analyzer": "cursor-grok-4.5-high",
    "gsd-eval-planner": "cursor-grok-4.5-high",
    "gsd-framework-selector": "cursor-grok-4.5-high",
    "gsd-security-auditor": "cursor-grok-4.5-high",
    "gsd-user-profiler": "cursor-grok-4.5-high",
    "gsd-verifier": "cursor-grok-4.5-medium",
    "gsd-code-reviewer": "cursor-grok-4.5-medium",
    "gsd-eval-auditor": "cursor-grok-4.5-medium",
    "gsd-phase-researcher": "composer-2.5",
    "gsd-project-researcher": "composer-2.5",
    "gsd-ui-researcher": "composer-2.5",
    "gsd-advisor-researcher": "composer-2.5",
    "gsd-ai-researcher": "composer-2.5",
    "gsd-domain-researcher": "composer-2.5",
    "gsd-doc-synthesizer": "composer-2.5",
    "gsd-research-synthesizer": "composer-2.5",
    "gsd-code-fixer": "composer-2.5",
    "gsd-doc-writer": "composer-2.5",
    "gsd-codebase-mapper": "composer-2.5",
    "gsd-pattern-mapper": "composer-2.5",
    "gsd-plan-checker": "composer-2.5",
    "gsd-integration-checker": "composer-2.5",
    "gsd-nyquist-auditor": "composer-2.5",
    "gsd-ui-checker": "composer-2.5",
    "gsd-ui-auditor": "composer-2.5",
    "gsd-doc-verifier": "composer-2.5",
    "gsd-doc-classifier": "composer-2.5",
    "gsd-intel-updater": "composer-2.5",
    "gsd-mempalace-curator": "composer-2.5"
  },
  "commit_docs": true,
  "parallelization": true,
  "search_gitignored": true,
  "brave_search": true,
  "firecrawl": false,
  "exa_search": true,
  "git": {
    "branching_strategy": "phase",
    "create_tag": true,
    "base_branch": "main",
    "phase_branch_template": "gsd/phase-{phase}-{slug}",
    "milestone_branch_template": "gsd/{milestone}-{slug}",
    "quick_branch_template": "gsd/quick-{quick}-{slug}"
  },
  "workflow": {
    "research": true,
    "plan_check": true,
    "verifier": true,
    "nyquist_validation": true,
    "auto_advance": false,
    "use_worktrees": false,
    "node_repair": true,
    "node_repair_budget": 2,
    "ui_phase": true,
    "ui_safety_gate": true,
    "ai_integration_phase": true,
    "human_verify_mode": "end-of-phase",
    "context_guard_mode": "warn",
    "text_mode": false,
    "research_before_questions": false,
    "discuss_mode": "discuss",
    "skip_discuss": false,
    "code_review": true,
    "code_review_depth": "standard",
    "code_review_command": null,
    "pattern_mapper": true,
    "plan_bounce": false,
    "plan_bounce_script": null,
    "plan_bounce_passes": 2,
    "auto_prune_state": false,
    "post_planning_gaps": true,
    "security_enforcement": true,
    "security_asvs_level": 1,
    "security_block_on": "high",
    "_auto_chain_active": false
  },
  "ship": {
    "pr_body_sections": [
      {
        "heading": "User Stories & Acceptance Criteria",
        "enabled": true,
        "source": "REQUIREMENTS.md ## User Stories || REQUIREMENTS.md ## Acceptance Criteria",
        "fallback": "- Acceptance criteria are covered by the linked requirements and verification evidence."
      },
      {
        "heading": "Risks & Dependencies",
        "enabled": true,
        "source": "PLAN.md ## Risks || PLAN.md ## Dependencies",
        "fallback": "- No known high-risk rollout dependencies."
      },
      {
        "heading": "Success Metrics & Release Criteria",
        "enabled": true,
        "source": "REQUIREMENTS.md ## Definition of Done || VERIFICATION.md ## Release Criteria",
        "fallback": "- Release when automated verification and required manual checks pass."
      },
      {
        "heading": "Stakeholder Review & Approval",
        "enabled": true,
        "template": "- Product owner approval pending for {phase_name}."
      }
    ]
  },
  "hooks": {
    "context_warnings": true
  },
  "project_code": null,
  "phase_naming": "sequential",
  "agent_skills": {},
  "claude_md_path": "./.cursor/rules/",
  "plan_review": {
    "source_grounding": true,
    "source_grounding_authority": "grep"
  },
  "resolve_model_ids": "omit",
  "mode": "yolo",
  "granularity": "standard",
  "response_language": "German"
}
